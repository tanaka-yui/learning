{
  "title": "RED — checkout-api",
  "schemaVersion": 39,
  "editable": true,
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request rate (req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_requests_total[1m]))", "datasource": { "type": "prometheus", "uid": "mimir" } }
      ]
    },
    {
      "id": 2,
      "title": "Error rate (req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_errors_total[1m])) or vector(0)", "datasource": { "type": "prometheus", "uid": "mimir" } }
      ]
    },
    {
      "id": 3,
      "title": "p95 latency (ms)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(http_server_duration_milliseconds_bucket[5m])) by (le))", "datasource": { "type": "prometheus", "uid": "mimir" } }
      ]
    }
  ]
}
